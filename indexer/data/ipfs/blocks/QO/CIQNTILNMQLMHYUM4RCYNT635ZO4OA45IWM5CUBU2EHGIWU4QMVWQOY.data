
ìätype File @entity {
  id: ID! # fileId
  owner: Bytes! # owner's address
  cid: String! # ipfs encrypted file CID
  ownerKeyChunks: [Bytes!]! # 4 chunks
  createdAt: BigInt!
  sharedWith: [Share!]! @derivedFrom(field: "file")
}

type Share @entity {
  id: ID!
  file: File!
  owner: Bytes!
  recipient: Bytes!
  keyChunks: [Bytes!]!
  timestamp: BigInt!
}
