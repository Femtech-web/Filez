{
  "compilerOptions": {
    "target": "ES2020",
    "types": [
      "node",
      "mocha",
      "chai",
      "chai-as-promised",
      "hardhat-chai-matchers"
    ],
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "scripts/deploy.js",
    "src/types/**/*",
    "src/types/framer-motion-patch"
  ],
  "exclude": ["node_modules"]
}
